<Window x:Class="TaskManagerWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Менеджер Задач" Height="450" Width="700">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- Форма ввода -->
        <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Text="Название задачи:" Margin="0,5,0,2"/>
            <TextBox x:Name="TxtTitle" Height="25"/>

            <TextBlock Text="Приоритет:" Margin="0,5,0,2"/>
            <ComboBox x:Name="CmbPriority" Height="25"/>

            <TextBlock Text="Срок выполнения:" Margin="0,5,0,2"/>
            <DatePicker x:Name="DpDueDate" Height="25"/>

            <Button Content="Добавить задачу" Click="BtnAdd_Click" Height="30" Margin="0,15,0,5"/>
            <Button Content="Удалить выбранную" Click="BtnDelete_Click" Height="30" Margin="0,5,0,5"/>
            <Button Content="Проверить дедлайны" Click="BtnCheckNotifications_Click" Height="30" Margin="0,5,0,5"/>
        </StackPanel>

        <!-- Таблица задач -->
        <DataGrid Grid.Column="1" x:Name="DgTasks" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Задача" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="Приоритет" Binding="{Binding Priority}" Width="80"/>
                <DataGridTextColumn Header="Срок" Binding="{Binding DueDate, StringFormat=\{0:dd.MM.yyyy\}}" Width="90"/>
                <DataGridCheckBoxColumn Header="Готово" Binding="{Binding IsCompleted}" Width="50"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>