<Window x:Class="mod_8.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Модуль 8: Учет расходов и доходов" Height="550" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#F8F9FA" Padding="15" CornerRadius="8" Margin="0,0,15,0">
            <StackPanel>
                <TextBlock Text="Новая операция" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
                <TextBlock Text="Тип операции:" FontWeight="SemiBold"/>
                <ComboBox x:Name="CbType" Height="25" Margin="0,5,0,10">
                    <ComboBoxItem Content="Расход" IsSelected="True"/>
                    <ComboBoxItem Content="Доход"/>
                </ComboBox>
                <TextBlock Text="Название / Описание:" FontWeight="SemiBold"/>
                <TextBox x:Name="TxtTitle" Height="25" Margin="0,5,0,10" Padding="3"/>
                <TextBlock Text="Сумма BUN:" FontWeight="SemiBold"/>
                <TextBox x:Name="TxtAmount" Height="25" Margin="0,5,0,10" Padding="3"/>
                <TextBlock Text="Категория:" FontWeight="SemiBold"/>
                <ComboBox x:Name="CbCategory" Height="25" Margin="0,5,0,10">
                    <ComboBoxItem Content="Продукты" IsSelected="True"/>
                    <ComboBoxItem Content="Транспорт"/>
                    <ComboBoxItem Content="Жилье / ЖКХ"/>
                    <ComboBoxItem Content="Развлечения"/>
                    <ComboBoxItem Content="Зарплата"/>
                    <ComboBoxItem Content="Другое"/>
                </ComboBox>
                <TextBlock Text="Дата:" FontWeight="SemiBold"/>
                <DatePicker x:Name="DpDate" Margin="0,5,0,20"/>
                <Button Content="Добавить запись" Height="35" Background="#28A745" Foreground="White" FontWeight="Bold" Click="BtnAdd_Click"/>
            </StackPanel>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Баланс: " FontWeight="Bold" FontSize="16"/>
                    <TextBlock x:Name="TxtBalance" Text="0 ₽" FontWeight="Bold" FontSize="16" Foreground="#007ACC"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="Фильтр:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,5,0"/>
                    <ComboBox x:Name="CbFilter" Width="120" Height="25" SelectionChanged="CbFilter_SelectionChanged">
                        <ComboBoxItem Content="Все" IsSelected="True"/>
                        <ComboBoxItem Content="Расходы"/>
                        <ComboBoxItem Content="Доходы"/>
                    </ComboBox>
                </StackPanel>
            </DockPanel>
            <ListView x:Name="LvTransactions" Grid.Row="1" Margin="0,0,0,10">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Тип" DisplayMemberBinding="{Binding Type}" Width="70"/>
                        <GridViewColumn Header="Название" DisplayMemberBinding="{Binding Title}" Width="160"/>
                        <GridViewColumn Header="Сумма" Width="90">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Amount, StringFormat={}{0:N2} BUN}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Категория" DisplayMemberBinding="{Binding Category}" Width="120"/>
                        <GridViewColumn Header="Дата" Width="90">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Date, StringFormat={}{0:dd.MM.yyyy}}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Удалить выбранную" Width="140" Height="30" Background="#DC3545" Foreground="White" Click="BtnDelete_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>