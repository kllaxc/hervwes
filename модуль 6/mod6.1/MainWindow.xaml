<Window x:Class="mod6_1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Учет сотрудников " Height="500" Width="850">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>

        <!-- Таблица сотрудников -->
        <DataGrid x:Name="dgEmployees" AutoGenerateColumns="True" IsReadOnly="True" SelectionMode="Single" Margin="0,0,10,0" SelectionChanged="DgEmployees_SelectionChanged"/>

        <!-- Панель управления -->
        <StackPanel Grid.Column="1">
            <TextBlock Text="ФИО:" FontWeight="Bold" Margin="0,0,0,3"/>
            <TextBox x:Name="txtFullName" Height="25" Margin="0,0,0,10"/>

            <TextBlock Text="Должность:" FontWeight="Bold" Margin="0,0,0,3"/>
            <TextBox x:Name="txtPosition" Height="25" Margin="0,0,0,10"/>

            <TextBlock Text="Отдел:" FontWeight="Bold" Margin="0,0,0,3"/>
            <TextBox x:Name="txtDepartment" Height="25" Margin="0,0,0,10"/>

            <TextBlock Text="Зарплата:" FontWeight="Bold" Margin="0,0,0,3"/>
            <TextBox x:Name="txtSalary" Height="25" Margin="0,0,0,15"/>

            <Button Content="Добавить" Height="30" Margin="0,0,0,8" Click="BtnAdd_Click"/>
            <Button Content="Редактировать" Height="30" Margin="0,0,0,8" Click="BtnEdit_Click"/>
            <Button Content="Удалить" Height="30" Background="#FFF5C6C6" Click="BtnDelete_Click"/>
        </StackPanel>
    </Grid>
</Window>