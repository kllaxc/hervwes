<Window x:Class="mod6_3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Библиотека (Модуль 6, Задание 3)" Height="500" Width="850">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Поиск:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0"/>
            <TextBox x:Name="txtSearch" Width="400" Height="25" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
            <Button Content="Найти" Width="100" Height="25" Click="BtnSearch_Click"/>
        </StackPanel>

        <DataGrid x:Name="dgBooks" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" 
                  Margin="0,0,0,10" RowHeight="28" FontSize="13">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название книги" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="Автор" Binding="{Binding Author}" Width="200"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="130"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <Button Content="Арендовать книгу" Width="150" Height="30" Margin="0,0,10,0" Click="BtnRent_Click"/>
            <Button Content="Вернуть в библиотеку" Width="160" Height="30" Click="BtnReturn_Click"/>
        </StackPanel>
    </Grid>
</Window>